[Unit]
Description=dit chatgpt — commande vocale locale
After=pipewire.service wireplumber.service

[Service]
Type=simple
Environment=DIT_CHATGPT_ROOT=__BUNDLE_ROOT__
Environment=DIT_CHATGPT_MODEL=__BUNDLE_ROOT__/model
Environment=PYTHONPATH=__BUNDLE_ROOT__/modules
ExecStartPre=__BUNDLE_ROOT__/scripts/ensure_dit_chatgpt_aec.sh
ExecStart=__PYTHON__ __BUNDLE_ROOT__/modules/nyxpulse_chatgpt_wake_v4.py --listen
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
